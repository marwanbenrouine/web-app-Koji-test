    "expect": { "httpStatus": 200, "eventsInclude": ["done"], "eventsExclude": ["error"] }
  },
  {
    "id": "DEVIS-003", "suite": "regression", "assistant": "devisChat", "authRole": "pro", "category": "majorations", "title": "Explication d'un total HT avec majoration",
    "input": {
      "message": "Pourquoi mon total HT est-il plus eleve que la somme des lignes ?",
      "quoteSnapshot": {
        "lots": [], "client": {},
        "totaux": { "sousTotalLignes": 1000, "majorations": [{ "label": "Coordination", "pourcentage": 10, "montant": 100 }], "totalHt": 1100 }
      }
    },
    "expect": { "httpStatus": 200, "eventsInclude": ["done"], "eventsExclude": ["error"] }
  },
  {
    "id": "DEVIS-004", "suite": "regression", "assistant": "devisChat", "authRole": "pro", "category": "correction", "title": "Correction d'une ligne existante sans doublon",
    "input": {
      "message": "Corrige la quantite de peinture de 10 m2 a 12 m2 sans creer une seconde ligne.",
      "quoteSnapshot": {
        "lots": [{ "nom": "Peinture", "lignes": [{ "id": "fixture-ligne-1", "designation": "Peinture murs", "quantite": 10, "unite": "m2", "prixUnitaireHt": 28, "totalHt": 280, "prixManquant": false }] }],
        "client": {}, "totaux": { "sousTotalLignes": 280, "majorations": [], "totalHt": 280 }
      }
    },
    "expect": { "httpStatus": 200, "eventsInclude": ["done"], "eventsExclude": ["error"], "actionsInclude": ["updateOuvrage"], "actionsExclude": ["addOuvrage"] }
  },
  {
    "id": "DEVIS-005", "suite": "regression", "assistant": "devisChat", "authRole": "pro", "category": "fin", "title": "Cloture d'un devis conversationnel",
